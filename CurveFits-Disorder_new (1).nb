            RowBox[{"0.7", ",", "0.4"}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], ",", 
    RowBox[{"Frame", "\[Rule]", "True"}], ",", 
    RowBox[{"FrameLabel", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<t\>\"", ",", "18", ",", "Bold"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<P(x = 0)\>\"", ",", "18", ",", "Bold"}], "]"}]}], 
