 RowBox[{
  RowBox[{"tVals", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{
      RowBox[{"Length", "[", "Px0", "]"}], "-", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"tVals", ",", "Px0"}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formula", "=", 
   RowBox[{"FindFormula", "[", 
    RowBox[{"data", ",", "t"}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
