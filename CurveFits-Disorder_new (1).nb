 RowBox[{
  RowBox[{"para", "=", 
   RowBox[{"FindFit", "[", 
    RowBox[{"data", ",", 
     RowBox[{"aa", "+", 
      RowBox[{"b", "*", "t"}], "+", 
      RowBox[{"c", "*", 
