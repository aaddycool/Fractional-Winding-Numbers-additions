Cell[CellGroupData[{
Cell["Without Disorder", "Section",
 CellChangeTimes->{{3.9962882024894543`*^9, 
  3.9962882074647655`*^9}},ExpressionUUID->"96bcbce6-cd6a-334a-93a1-\
2b258872b88a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "SetDirectory", "[", "\"\<C:\\\\Users\\\\MINI\\\\Downloads\>\"", "]"}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"pro", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"\"\<withoutdisorder.dat\>\"", ",", "\"\<Table\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dimensions", "[", "pro", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tmax", "=", "100"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tVals", "=", 
   RowBox[{"pro", "[", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{"1", ";;", 
       RowBox[{"tmax", "+", "1"}]}], ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Px0", "=", 
    RowBox[{"pro", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", 
        RowBox[{"tmax", "+", "1"}]}], ",", "2"}], "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"tVals", ",", "Px0"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"formula", "=", 
    RowBox[{"FindFormula", "[", 
     RowBox[{"data", ",", "t"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<FindFormula = \>\"", ",", "formula"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"constt", "=", 
    RowBox[{"Mean", "[", "Px0", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Mean P(x=0) = \>\"", ",", 
     RowBox[{"N", "[", 
      RowBox[{"constt", ",", "10"}], "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"data", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"PointSize", "[", "0.018", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Data points\>\"", ",", "16", ",", "Bold"}], "]"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.80", ",", "0.20"}], "}"}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{"constt", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Thick"}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Constant fit\>\"", ",", "16", ",", "Bold"}], "]"}], 
           "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.80", ",", "0.30"}], "}"}]}], "]"}]}]}], "]"}]}], "}"}], 
   ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t\>\"", ",", "20", ",", "Bold"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<P(x = 0)\>\"", ",", "20", ",", "Bold"}], "]"}]}], "}"}]}],
    ",", 
   RowBox[{"FrameTicksStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"14", ",", "Bold"}], "]"}]}], ",", 
   RowBox[{"FrameStyle", "->", "Thick"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "tmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.8", ",", "1.0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "=", 
    RowBox[{"Px0", "-", "constt"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmse", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{"res", "^", "2"}], "]"}], "]"}], ",", "10"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<RMSE = \>\"", ",", "rmse"}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"std", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"StandardDeviation", "[", "Px0", "]"}], ",", "10"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Standard deviation = \>\"", ",", "std"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxres", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", "res", "]"}], "]"}], ",", "10"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Maximum absolute residual = \>\"", ",", "maxres"}], "]"}], 
   ";"}], "\n"}], "\n"}], "Input",
 CellChangeTimes->{{3.99628728643421*^9, 3.99628730405081*^9}, {
